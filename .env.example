# =========================================================
# SnipGift — переменные окружения
# Скопируй этот файл в .env и заполни значения.
# На Render: Dashboard -> ваш сервис -> Environment -> Add
# =========================================================

# Обязательные
# Токен бота от @BotFather (типа 123456:ABC-DEF...)
BOT_TOKEN=

# Полный URL приложения на Render, БЕЗ слэша в конце:
#   https://<app-name>.onrender.com
# На него бот ставит webhook (<url>/webhook)
WEBHOOK_URL=

# Строка подключения к PostgreSQL (Neon.tech / Supabase):
#   postgresql://user:password@host/dbname?sslmode=require
# Для Neon: Project Dashboard -> Connection String -> copy
DATABASE_URL=

# --- Auth данных пользователя для сервисов ------------------
# Получаются из Web App (initData) внутри самих мини-аппов.
# Пустая строка = клиент работает в анонимном/gray-режиме.
# TODO: автоматическое обновление через MTProto.
TONNEL_AUTH_DATA=
MRKT_AUTH_DATA=
PORTALS_AUTH_DATA=
FRAGMENT_AUTH_DATA=

# Если используешь сторонний API для превью/метаданных подарков
GIFT_ASSET_API_KEY=

# --- Переопределение комиссий маркетов (доли, 0.10 = 10%) ---
# Если не заданы — берутся значения по умолчанию из utils/fees.py
FEE_TONNEL=0.10
FEE_MRKT=0.05
FEE_PORTALS=0.10
FEE_FRAGMENT=0.00

# --- Опциональные тюнинг-параметры (есть дефолты) ----------
# Интервал сканирования в секундах
SCAN_INTERVAL=7
# Интервал self-ping (держит free-инстанс живым), сек
SELF_PING_INTERVAL=600
# Время жизни записи о "уже виденном" листинге, сек
LISTINGS_TTL=3600
# Таймаут HTTP-запросов к маркетам, сек
REQUEST_TIMEOUT=15
# Кол-во ретраев при ошибке/429
MAX_RETRIES=3
# Уровень логов: INFO / DEBUG / WARNING
LOG_LEVEL=INFO

# --- Локальная разработка (НЕ трогай на Render) ------------
# PORT и HOST подставляет Render автоматически.
HOST=0.0.0.0
PORT=8080
# Локальная SQLite, если не указан DATABASE_URL (данные не сохранятся после рестарта!)
LOCAL_SQLITE_PATH=/tmp/snipgift.db